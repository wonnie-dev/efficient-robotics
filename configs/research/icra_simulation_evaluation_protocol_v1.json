{
  "schema_version": "icra-simulation-evaluation-protocol-v1",
  "status": "pre_freeze",
  "paper_target": "ICRA 2027",
  "paper_claim": "Task-risk-aware belief-space MPC over relation-uncertain Scene Graphs reduces wrong commitment and total retrieval cost under partial observability.",
  "embodiment": {
    "simulator": "NVIDIA Isaac Sim 6.0.1",
    "robot": "Universal Robots UR10e",
    "gripper": "OnRobot RG6",
    "camera": "wrist-mounted Zivid 2 RGB-D approximation"
  },
  "data_split": {
    "perception_and_policy_calibration_seeds": {
      "start_inclusive": 165,
      "stop_inclusive": 199
    },
    "reserved_test_seeds": [200, 201, 202, 203, 204, 205, 206, 207, 208, 209],
    "development_integration_seeds": [188, 197],
    "test_labels_hidden_until_all_parameters_frozen": true,
    "test_seed_reuse_for_tuning_forbidden": true
  },
  "instruction_protocol": {
    "template": "Find and pick up the red mug with the white logo.",
    "identity_attributes_only": true,
    "relation_answer_in_instruction_forbidden": true,
    "view_context_reset": true
  },
  "scenario_families": [
    {
      "id": "A_open_container_active_view",
      "description": "Open container with target identity, membership, behind, and occlusion ambiguity resolved by wrist-camera motion.",
      "test_seeds": [200, 201, 202, 203, 204, 205, 206, 207, 208, 209],
      "balanced_variants": ["close_high_only", "right_only", "either_view", "rim_occluded", "behind_ambiguous"],
      "candidate_actions": ["grasp", "viewpoint_close_high", "viewpoint_right", "defer"],
      "minimum_belief_updates": 1
    },
    {
      "id": "B_removable_cover_negative_evidence",
      "description": "Covered basket search with positive or empty inspection, negative-evidence belief update, re-observation, and retrieval.",
      "test_seeds": [200, 201, 202, 203, 204, 205, 206, 207, 208, 209],
      "balanced_variants": ["target_inside_covered", "empty_cover_then_right"],
      "candidate_actions": ["remove_cover", "viewpoint_close_high", "viewpoint_right", "grasp_inside", "grasp_outside", "defer"],
      "minimum_belief_updates": 2
    }
  ],
  "methods": [
    "direct_perception_immediate_grasp",
    "deterministic_scene_graph_planner",
    "object_node_uncertainty_without_relation_edges",
    "fixed_viewpoint_policy",
    "greedy_one_step_information_gain",
    "entropy_only_without_task_risk",
    "proposed_task_risk_aware_action_conditioned_belief_mpc"
  ],
  "ablations": [
    "no_relation_edge_uncertainty",
    "no_calibration_raw_scores",
    "no_action_conditioned_future_belief",
    "no_negative_evidence_update",
    "no_task_loss_or_wrong_commitment_cost",
    "horizon_one_greedy"
  ],
  "evaluation_scale": {
    "test_seed_count_per_scenario": 10,
    "scenario_count": 2,
    "method_count_including_proposed": 7,
    "ablation_count": 6,
    "main_method_scenario_episodes": 140,
    "ablation_scenario_episodes": 120,
    "total_policy_evaluations": 260,
    "counterfactual_action_branches_cached_before_method_scoring": true,
    "vlm_outputs_cached_by_image_and_prompt_hash": true
  },
  "high_fidelity_physics_subset": {
    "predeclared_test_seeds": [200, 204, 208],
    "methods": [
      "direct_perception_immediate_grasp",
      "greedy_one_step_information_gain",
      "proposed_task_risk_aware_action_conditioned_belief_mpc"
    ],
    "scenario_families": [
      "A_open_container_active_view",
      "B_removable_cover_negative_evidence"
    ],
    "purpose": "Validate that policy-level outcomes remain executable with UR10e/RG6 contact physics."
  },
  "primary_metrics": [
    "task_success_rate",
    "wrong_commitment_rate",
    "total_cost_to_successful_retrieval"
  ],
  "secondary_metrics": [
    "target_and_relation_brier_score",
    "target_and_relation_ece",
    "negative_evidence_update_accuracy",
    "planning_time_seconds",
    "episode_runtime_seconds",
    "collision_rate",
    "belief_update_count",
    "replanning_count"
  ],
  "relation_ground_truth_policy": {
    "membership": "simulator_world_geometry",
    "occluded_by_reference": "rendered_reference_removed_amodal_fraction",
    "behind": "camera_relative_simulator_world_bounds_current_camera_ray_and_rendered_projected_overlap",
    "behind_label_space": ["yes", "no", "unknown"],
    "behind_minimum_target_bbox_overlap": 0.1,
    "behind_far_edge_abstention_m": 0.02,
    "simulator_ground_truth_exposed_to_model_or_planner": false,
    "legacy_generator_view_intent_valid_for_final_metrics": false
  },
  "physical_success_gates": {
    "correct_target_required": true,
    "minimum_verified_lift_m": 0.15,
    "bilateral_contact_required": true,
    "maximum_force_per_finger_n": 60.0,
    "maximum_penetration_m": 0.003,
    "maximum_target_relative_translation_m": 0.015,
    "maximum_target_relative_rotation_rad": 0.17453292519943295,
    "unexpected_environment_collision_allowed": false,
    "object_attachment_allowed": false,
    "object_pose_copying_allowed": false,
    "finite_joint_state_required": true
  },
  "wrong_commitment_definition": [
    "wrong_object_grasp",
    "empty_or_disproven_location_grasp",
    "premature_irreversible_interaction",
    "repeating_an_action_after_negative_evidence_disproves_its_hypothesis"
  ],
  "statistics": {
    "confidence_level": 0.95,
    "binary_metric_interval": "Wilson",
    "paired_binary_comparison": "exact_McNemar",
    "paired_cost_interval": "episode_paired_bootstrap_10000_resamples",
    "report_all_failures_by_category": true
  },
  "calibration_freeze_requirements": {
    "minimum_open_container_calibration_episodes": 20,
    "minimum_cover_negative_evidence_calibration_episodes": 10,
    "qwen_temperature_frozen": true,
    "relation_likelihoods_frozen": true,
    "action_conditioned_observation_models_frozen": false,
    "task_cost_weights_frozen": false,
    "commitment_gate_frozen": false,
    "prompt_and_model_revision_hashes_frozen": true,
    "frozen_parameters_path": "configs/research/icra_frozen_parameters_v1.json"
  },
  "execution_policy": {
    "single_gpu_only": true,
    "one_model_instance_at_a_time": true,
    "distributed_or_multi_gpu_forbidden": true,
    "training_or_finetuning_performed": false,
    "reserved_test_launch_requires_passing_preflight": true
  },
  "output_root": "outputs/final_evaluation/icra_protocol_v1",
  "training_performed": false,
  "testing_performed": false,
  "reserved_test_seeds_used": false,
  "valid_for_final_evaluation": false
}
