{
  "schema_version": "single-gpu-pilot-config-v1",
  "status": "pipeline_debugging_only_not_final_evaluation",
  "gpu": {
    "physical_gpu": 5,
    "cuda_visible_devices": "5",
    "internal_cuda_device": "cuda:0",
    "maximum_visible_device_count": 1,
    "batch_size": 1,
    "distributed": false,
    "parallel_vlm_jobs": false
  },
  "model": {
    "name": "Qwen3-VL-8B-Instruct",
    "mode": "pretrained_inference_only",
    "training": false,
    "fine_tuning": false,
    "lora": false
  },
  "pilot": {
    "deterministic_episode_first": "benchmark_seed000",
    "planned_seed_start": 0,
    "planned_seed_stop_exclusive": 10,
    "views": ["left", "center", "right", "close_high"],
    "maximum_episodes_per_run": 10,
    "run_full_paper_evaluation": false
  },
  "cache": {
    "root": "outputs/pilot_cache/qwen3_vl",
    "key_fields": [
      "input_json_sha256",
      "all_image_asset_sha256",
      "model_revision",
      "prompt_version",
      "max_pixels_per_image"
    ]
  },
  "data_policy": {
    "manual_annotation": false,
    "simulator_ground_truth_for_inference": false,
    "simulator_ground_truth_for_debug_evaluation": true,
    "split_unit": "episode_and_scene_seed",
    "multiple_views_must_remain_in_same_split": true
  },
  "phase_definitions": {
    "training": "not_performed",
    "calibration": "future_confidence_adjustment_on_held_out_labeled_episodes",
    "testing": "future_final_unbiased_method_evaluation"
  }
}
