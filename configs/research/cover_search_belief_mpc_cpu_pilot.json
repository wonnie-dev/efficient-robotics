{
  "schema_version": "cover-search-belief-mpc-config-v1",
  "experiment_id": "cover_search_belief_mpc_cpu_pilot",
  "purpose": "validate_remove_cover_negative_evidence_and_replanning_without_gpu",
  "planner": "exact_discrete_action_observation_belief_tree",
  "horizon": 3,
  "state_space": [
    "inside|covered",
    "inside|open",
    "outside_near|covered",
    "outside_near|open"
  ],
  "initial_belief": {
    "inside|covered": 0.65,
    "inside|open": 0.0,
    "outside_near|covered": 0.35,
    "outside_near|open": 0.0
  },
  "actions": {
    "viewpoint_close_high": {
      "kind": "observation",
      "enabled": true,
      "stage_cost": 0.1
    },
    "viewpoint_right": {
      "kind": "observation",
      "enabled": true,
      "stage_cost": 0.08
    },
    "remove_cover": {
      "kind": "interaction_observation",
      "enabled": true,
      "stage_cost": 0.18,
      "minimum_covered_probability": 0.1
    },
    "grasp_inside": {
      "kind": "terminal_grasp",
      "enabled": true,
      "stage_cost": 0.12,
      "success_states": ["inside|open"]
    },
    "grasp_outside": {
      "kind": "terminal_grasp",
      "enabled": true,
      "stage_cost": 0.12,
      "success_states": [
        "outside_near|covered",
        "outside_near|open"
      ]
    },
    "defer": {
      "kind": "terminal_defer",
      "enabled": true,
      "stage_cost": 0.6
    }
  },
  "transition_model": {
    "viewpoint_close_high": {
      "type": "identity"
    },
    "viewpoint_right": {
      "type": "identity"
    },
    "remove_cover": {
      "type": "covered_to_open",
      "success_probability": 0.97
    }
  },
  "observation_model": {
    "viewpoint_close_high": {
      "outcomes": [
        "inside_evidence",
        "outside_evidence",
        "unknown_evidence"
      ],
      "likelihood": {
        "inside|covered": {
          "inside_evidence": 0.1,
          "outside_evidence": 0.05,
          "unknown_evidence": 0.85
        },
        "inside|open": {
          "inside_evidence": 0.88,
          "outside_evidence": 0.04,
          "unknown_evidence": 0.08
        },
        "outside_near|covered": {
          "inside_evidence": 0.05,
          "outside_evidence": 0.1,
          "unknown_evidence": 0.85
        },
        "outside_near|open": {
          "inside_evidence": 0.04,
          "outside_evidence": 0.88,
          "unknown_evidence": 0.08
        }
      }
    },
    "viewpoint_right": {
      "outcomes": [
        "inside_evidence",
        "outside_evidence",
        "unknown_evidence"
      ],
      "likelihood": {
        "inside|covered": {
          "inside_evidence": 0.1,
          "outside_evidence": 0.08,
          "unknown_evidence": 0.82
        },
        "inside|open": {
          "inside_evidence": 0.78,
          "outside_evidence": 0.07,
          "unknown_evidence": 0.15
        },
        "outside_near|covered": {
          "inside_evidence": 0.08,
          "outside_evidence": 0.1,
          "unknown_evidence": 0.82
        },
        "outside_near|open": {
          "inside_evidence": 0.07,
          "outside_evidence": 0.78,
          "unknown_evidence": 0.15
        }
      }
    },
    "remove_cover": {
      "outcomes": [
        "target_detected",
        "empty_container",
        "action_failed"
      ],
      "likelihood": {
        "inside|covered": {
          "target_detected": 0.01,
          "empty_container": 0.04,
          "action_failed": 0.95
        },
        "inside|open": {
          "target_detected": 0.92,
          "empty_container": 0.07,
          "action_failed": 0.01
        },
        "outside_near|covered": {
          "target_detected": 0.01,
          "empty_container": 0.04,
          "action_failed": 0.95
        },
        "outside_near|open": {
          "target_detected": 0.03,
          "empty_container": 0.96,
          "action_failed": 0.01
        }
      }
    }
  },
  "objective": {
    "wrong_commitment_weight": 1.0,
    "minimum_grasp_success_probability": 0.85,
    "noncompletion_cost": 0.6,
    "status": "hand_specified_cpu_debug_costs_not_calibrated"
  },
  "scripted_diagnostic_episodes": [
    {
      "episode_id": "target_inside_positive_evidence",
      "true_state_posthoc": "inside|covered",
      "observations": [
        {
          "expected_action": "remove_cover",
          "outcome": "target_detected"
        }
      ],
      "expected_terminal_action": "grasp_inside"
    },
    {
      "episode_id": "target_outside_negative_evidence",
      "true_state_posthoc": "outside_near|covered",
      "observations": [
        {
          "expected_action": "remove_cover",
          "outcome": "empty_container"
        },
        {
          "expected_action": "viewpoint_close_high",
          "outcome": "outside_evidence"
        }
      ],
      "expected_terminal_action": "grasp_outside"
    },
    {
      "episode_id": "cover_removal_retry_after_failure",
      "true_state_posthoc": "outside_near|covered",
      "observations": [
        {
          "expected_action": "remove_cover",
          "outcome": "action_failed"
        },
        {
          "expected_action": "remove_cover",
          "outcome": "empty_container"
        }
      ],
      "expected_terminal_action": "grasp_outside"
    }
  ],
  "output_root": "outputs/offline_mpc/cover_search_belief_mpc_cpu_pilot",
  "robot_motion_mpc_executed": false,
  "cover_manipulation_executed": false,
  "training_performed": false,
  "calibration_performed": false,
  "testing_performed": false,
  "valid_for_final_evaluation": false
}
