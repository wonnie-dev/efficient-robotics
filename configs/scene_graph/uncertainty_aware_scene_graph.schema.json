{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efficient-robotics.local/schemas/uncertainty-aware-scene-graph-v0.2.0-draft.json",
  "title": "Efficient Robotics Uncertainty-Aware Scene Graph",
  "description": "Draft interface for task-conditioned target and spatial-relation beliefs. It does not fix the final uncertainty, calibration, or task-risk equations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_status",
    "scene_id",
    "task",
    "observation",
    "nodes",
    "edges",
    "graph_belief",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0-draft"},
    "schema_status": {"const": "provisional_pending_overleaf_method_definition"},
    "scene_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": ["string", "null"]},
    "seed": {"type": "integer", "minimum": 0},
    "task": {"$ref": "#/$defs/task"},
    "observation": {"$ref": "#/$defs/observation"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "graph_belief": {"$ref": "#/$defs/graphBelief"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "probability": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "nullableMetric": {
      "type": ["number", "null"]
    },
    "probabilityDistribution": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/probability"}
    },
    "uncertaintyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "value", "calibrated"],
      "properties": {
        "status": {
          "enum": ["available", "pending_definition", "not_observed"]
        },
        "method": {"type": ["string", "null"]},
        "value": {"$ref": "#/$defs/nullableMetric"},
        "calibrated": {"type": "boolean"},
        "units": {"type": ["string", "null"]}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction", "target_condition", "allowed_relations"],
      "properties": {
        "instruction": {"type": "string", "minLength": 1},
        "target_condition": {"type": "string", "minLength": 1},
        "allowed_relations": {
          "type": "array",
          "items": {
            "enum": ["inside", "outside", "near", "behind", "occluded_by", "on"]
          },
          "uniqueItems": true
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_id", "sequence_index", "rgb_path", "depth_path", "camera_prim"],
      "properties": {
        "view_id": {"type": "string", "minLength": 1},
        "sequence_index": {"type": "integer", "minimum": 0},
        "rgb_path": {"type": "string", "minLength": 1},
        "depth_path": {"type": "string", "minLength": 1},
        "camera_prim": {"type": "string", "minLength": 1},
        "timestamp_seconds": {"type": ["number", "null"], "minimum": 0.0}
      }
    },
    "nodeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "visible_fraction", "bbox_xyxy", "depth_mean_m"],
      "properties": {
        "visible": {"type": "boolean"},
        "visible_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "bbox_xyxy": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "prefixItems": [
                {"type": "integer", "minimum": 0},
                {"type": "integer", "minimum": 0},
                {"type": "integer", "minimum": 0},
                {"type": "integer", "minimum": 0}
              ],
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "depth_mean_m": {"type": ["number", "null"], "minimum": 0.0}
      }
    },
    "nodeBelief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_distribution",
        "target_probability",
        "target_uncertainty",
        "source"
      ],
      "properties": {
        "class_distribution": {"$ref": "#/$defs/probabilityDistribution"},
        "target_probability": {"$ref": "#/$defs/probability"},
        "target_uncertainty": {"$ref": "#/$defs/uncertaintyRecord"},
        "source": {
          "enum": ["ground_truth_stub", "rule_based_stub", "vlm", "grounding_model", "multi_view_fusion"]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "observation", "belief", "last_observed_view"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "enum": ["object", "container", "occluder", "cover", "observation_view"]
        },
        "observation": {"$ref": "#/$defs/nodeObservation"},
        "belief": {"$ref": "#/$defs/nodeBelief"},
        "last_observed_view": {"type": "string", "minLength": 1}
      }
    },
    "edgeBelief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_distribution", "relation_uncertainty", "source"],
      "properties": {
        "relation_distribution": {"$ref": "#/$defs/probabilityDistribution"},
        "relation_uncertainty": {"$ref": "#/$defs/uncertaintyRecord"},
        "source": {
          "enum": ["ground_truth_stub", "rule_based_stub", "vlm", "grounding_model", "geometry", "multi_view_fusion"]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "type", "belief", "last_updated_view"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "type": {"const": "spatial_relation_belief"},
        "belief": {"$ref": "#/$defs/edgeBelief"},
        "last_updated_view": {"type": "string", "minLength": 1}
      }
    },
    "graphBelief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "most_likely_target",
        "target_uncertainty",
        "relation_uncertainty",
        "task_failure_risk",
        "observation_count"
      ],
      "properties": {
        "most_likely_target": {"type": ["string", "null"]},
        "target_uncertainty": {"$ref": "#/$defs/uncertaintyRecord"},
        "relation_uncertainty": {"$ref": "#/$defs/uncertaintyRecord"},
        "task_failure_risk": {"$ref": "#/$defs/uncertaintyRecord"},
        "observation_count": {"type": "integer", "minimum": 1},
        "joint_task_state_distribution": {
          "$ref": "#/$defs/probabilityDistribution"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_file", "perception_source", "ground_truth_used_for_control"],
      "properties": {
        "schema_file": {"type": "string", "minLength": 1},
        "perception_source": {"type": "string", "minLength": 1},
        "ground_truth_used_for_control": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    }
  }
}
